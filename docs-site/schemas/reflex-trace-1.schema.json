{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://branes-ai.github.io/reflex/schemas/reflex-trace-1.schema.json",
  "title": "reflex-trace/1",
  "description": "Structure and types of a reflex trace. The semantic rules (cardinality, monotone uniform time, unit quaternions, event range, units of non-reserved channels) are checked by src/lib/trace/validate.js. Normative text: docs/standards/animation (Trace schema).",
  "type": "object",
  "required": ["schema", "provenance", "frames", "t", "channels"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "reflex-trace/1" },
    "provenance": {
      "type": "object",
      "required": ["commit", "block", "scenario", "seed", "compiler", "dt_sim"],
      "additionalProperties": false,
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "block": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer" },
        "compiler": { "type": "string", "minLength": 1 },
        "dt_sim": { "type": "number", "exclusiveMinimum": 0 },
        "dt_trace": { "type": "number", "exclusiveMinimum": 0 },
        "equivalence": {
          "type": "object",
          "required": ["justification"],
          "additionalProperties": false,
          "properties": {
            "justification": { "type": "string", "minLength": 1 },
            "horizon": { "type": "number", "exclusiveMinimum": 0 },
            "tolerances": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "rtol": { "type": "number", "minimum": 0 },
                  "atol": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "frames": {
      "type": "object",
      "required": ["world", "body", "rotors"],
      "additionalProperties": false,
      "properties": {
        "world": { "const": "z-up" },
        "body": { "const": "x-forward y-left z-up" },
        "rotors": { "const": "px4-quad-x" }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arm_length": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "t": { "type": "array", "minItems": 1, "items": { "type": "number" } },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            { "type": "number" },
            { "type": "array", "minItems": 1, "items": { "type": "number" } }
          ]
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "label"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "number" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "metric", "unit", "value", "limit", "comparison", "pass"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[A-Z]+[0-9]+$" },
          "metric": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "limit": { "type": "number" },
          "comparison": { "enum": ["<=", ">="] },
          "pass": { "type": "boolean" }
        }
      }
    }
  }
}
